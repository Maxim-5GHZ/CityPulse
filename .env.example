# ── CityPulse: один .env на всё (dev и prod) ──
# Скопируй в .env и подправь под себя: cp .env.example .env

# Postgres
POSTGRES_DB=citypulse
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=citypulse
POSTGRES_PORT=5432

# Порты наружу
BACKEND_PORT=8080
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# Бэкенд: JWT (минимум 32 символа!) и сид админа на старте
JWT_SECRET=change-me-to-at-least-32-chars-long-secret!
APP_ADMIN_EMAIL=admin@citypulse.local
APP_ADMIN_PASSWORD=admin

# Флида ID: вся логика на бэкенде (confidential-клиент), секрет только серверу.
# Взять в консоли Флида ID, в репозиторий не коммитить.
FLIDA_CLIENT_ID=твой-client-id-из-консоли-флида
FLIDA_CLIENT_SECRET=твой-client-secret-из-консоли-флида
FLIDA_AUTHORIZE_URI=https://id.flida.ru/api/oidc/authorize
FLIDA_TOKEN_URI=https://id.flida.ru/api/oidc/token
FLIDA_USERINFO_URI=https://id.flida.ru/api/oidc/userinfo
# Dev: через фронт-origin; prod: боевой домен. Побуквенно = Redirect URL в консоли!
FLIDA_DEV_REDIRECT_URI=http://localhost:3000/flida/oauth2/callback
FLIDA_DEV_FRONTEND_URL=http://localhost:3000
FLIDA_PROD_REDIRECT_URI=https://hotcodeband.ru/flida/oauth2/callback
FLIDA_PROD_FRONTEND_URL=https://hotcodeband.ru
