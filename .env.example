# ── CityPulse: один .env на всё (dev и prod) ──
# Скопируй в .env и подправь под себя: cp .env.example .env

# Postgres
POSTGRES_DB=citypulse
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=citypulse
POSTGRES_PORT=5432

# Порты наружу
BACKEND_PORT=8080
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# Бэкенд: JWT (минимум 32 символа!) и сид админа на старте
JWT_SECRET=change-me-to-at-least-32-chars-long-secret!
APP_ADMIN_EMAIL=admin@citypulse.local
APP_ADMIN_PASSWORD=admin

# Флида ID в схеме Web SDK (public-клиент, секрета нет и не надо).
# Client ID публичный — уходит во фронт через NEXT_PUBLIC_*.
# redirectUri = origin + /flida/finish, зарегистрируй его в консоли (Платформы | Web).
NEXT_PUBLIC_FLIDA_CLIENT_ID=твой-client-id-из-консоли-флида
# Бэкенду нужен только userinfo, чтобы перепроверить Flida access_token сервер-сервер.
FLIDA_USERINFO_URI=https://id.flida.ru/api/oidc/userinfo
